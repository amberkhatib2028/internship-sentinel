{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DedupeState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::SENTINEL_BUCKET/*"
    },
    {
      "Sid": "DedupeStateList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::SENTINEL_BUCKET"
    },
    {
      "Sid": "SendAlerts",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail", "sns:Publish"],
      "Resource": "*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
